#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "hold-preferred";
    quick-tap-ms = <100>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_minus {
            bindings = <&kp MINUS>;
            key-positions = <58 34>;
            layers = <0>;
        };

        combo_left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <58 21>;
            layers = <0>;
        };

        combo_right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <58 21>;
            layers = <0>;
        };

        combo_equal {
            bindings = <&kp EQUAL>;
            key-positions = <58 33>;
            layers = <0>;
        };

        combo_slash {
            bindings = <&kp SLASH>;
            key-positions = <58 20>;
            layers = <0>;
        };

        combo_backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <58 32>;
            layers = <0>;
        };

        combo_F1 {
            bindings = <&kp F1>;
            key-positions = <56 13>;
            layers = <0>;
        };

        combo_F2 {
            bindings = <&kp F2>;
            key-positions = <56 14>;
            layers = <0>;
        };

        combo_F3 {
            bindings = <&kp F3>;
            key-positions = <56 15>;
            layers = <0>;
        };

        combo-F4 {
            bindings = <&kp F4>;
            key-positions = <56 16>;
            layers = <0>;
        };

        combo_F5 {
            bindings = <&kp F5>;
            key-positions = <56 25>;
            layers = <0>;
        };

        combo_F6 {
            bindings = <&kp F6>;
            key-positions = <56 26>;
            layers = <0>;
        };

        combo_F7 {
            bindings = <&kp F7>;
            key-positions = <56 27>;
            layers = <0>;
        };

        combo_F8 {
            bindings = <&kp F8>;
            key-positions = <56 28>;
            layers = <0>;
        };

        combo_F9 {
            bindings = <&kp F9>;
            key-positions = <56 37>;
            layers = <0>;
        };

        combo_F10 {
            bindings = <&kp F10>;
            key-positions = <56 38>;
            layers = <0>;
        };

        combo_F11 {
            bindings = <&kp F11>;
            key-positions = <56 39>;
            layers = <0>;
        };

        combo_F12 {
            bindings = <&kp F12>;
            key-positions = <56 40>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DVORAK";
            bindings = <
&kp ESC    &kp N1          &kp N2        &kp N3        &kp N4        &kp N5                                     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0         &kp GRAVE
&kp TAB    &kp SQT         &kp COMMA     &kp DOT       &kp P         &kp Y                                      &kp F   &kp G   &kp C   &kp R   &kp L          &kp BSPC
&kp LCTRL  &kp A           &kp O         &kp E         &kp U         &kp I                                      &kp D   &kp H   &kp T   &kp N   &kp S          &kp RET
&kp LSHFT  &kp SEMI        &kp Q         &kp J         &kp K         &kp X      &lt 7 PAGE_DOWN  &lt 2 PAGE_UP  &kp B   &kp M   &kp W   &kp V   &kp Z          &kp RSHFT
&kp GLOBE  &sk LEFT_SHIFT  &kp CAPSLOCK  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &mo 4            &lt 3 ENTER    &mo 1                           &kp RIGHT_GUI  &kp RIGHT_ALT
            >;
        };

        symbol_layer {
            bindings = <
&none  &kp F1  &kp F2    &kp F3    &kp F4     &kp F5                &kp F6     &kp F7    &kp F8    &kp F9     &kp F10    &none
&none  &none   &none     &kp UP    &none      &none                 &kp F11    &kp F12   &kp FSLH  &kp LBKT   &kp RBKT   &kp BSPC
&none  &none   &kp LEFT  &kp DOWN  &kp RIGHT  &none                 &kp PG_UP  &kp HOME  &kp BSLH  &kp EQUAL  &kp MINUS  &kp RET
&none  &none   &none     &none     &none      &none   &none  &none  &kp PG_DN  &kp END   &none     &none      &none      &none
&none  &none   &none     &none     &none      &none   &none  &none  &none                                     &none      &none
            >;

            label = "SYM";
        };

        number_layer {
            label = "NUM";
            bindings = <
&none  &none  &none  &none  &none  &none                &none            &kp KP_CLEAR     &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_MINUS  &none
&none  &none  &none  &none  &none  &none                &none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS   &none
&none  &none  &none  &none  &none  &none                &none            &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none         &none
&none  &none  &none  &none  &none  &none  &none  &none  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT    &none
&none  &none  &none  &none  &none  &none  &none  &none  &kp KP_ENTER                                                        &none         &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans                  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans                  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans  &trans    &trans    &trans  &trans     &trans  &trans
&trans  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans                                 &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &none  &none     &none     &none      &none                   &none          &none      &none     &none      &none   &none
&trans  &none  &none     &kp UP    &none      &none                   &none          &none      &mo 5     &mo 6      &none   &trans
&trans  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &none                   &kp PAGE_UP    &mkp LCLK  &mkp MB3  &mkp RCLK  &none   &trans
&trans  &none  &none     &none     &none      &none   &trans  &trans  &kp PAGE_DOWN  &mkp MB4   &none     &mkp MB5   &none   &trans
&none   &none  &trans    &trans    &trans     &trans  &trans  &trans  &trans                                         &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &none  &none   &none   &none   &none                   &none   &none      &none      &none      &none   &none
&trans  &none  &none   &none   &none   &none                   &none   &none      &none      &none      &none   &trans
&trans  &none  &none   &none   &none   &none                   &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &none   &trans
&trans  &none  &none   &none   &none   &none   &trans  &trans  &none   &none      &none      &none      &none   &trans
&none   &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &none  &none   &none   &none   &none                   &none   &none      &none      &none      &none   &none
&trans  &none  &none   &none   &none   &none                   &none   &none      &none      &none      &none   &trans
&trans  &none  &none   &none   &none   &none                   &none   &mkp LCLK  &mkp MCLK  &mkp RCLK  &none   &trans
&trans  &none  &none   &none   &none   &none   &trans  &trans  &none   &none      &none      &none      &none   &trans
&none   &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans
            >;
        };

        system_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3  &bt BT_SEL 4                &bt BT_CLR_ALL  &none  &none  &none  &none           &none
&none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_AUTO  &none         &none                       &none           &none  &none  &none  &none           &none
&none       &kp C_VOL_DN          &kp C_VOLUME_UP       &kp K_MUTE             &none         &to 0                       &none           &none  &none  &none  &none           &none
&none       &kp C_PREVIOUS        &kp C_PLAY_PAUSE      &kp C_NEXT             &none         &tog 8        &none  &none  &none           &none  &none  &none  &none           &none
&none       &none                 &none                 &none                  &none         &none         &none  &none  &none                                &studio_unlock  &bootloader
            >;

            label = "SYS";
        };

        QWERTY {
            label = "QWRTY";
            bindings = <
&kp ESC         &kp N1          &kp N2        &kp N3        &kp N4    &kp N5                               &kp N6     &kp N7  &kp N8     &kp N9   &kp N0            &kp GRAVE
&kp TAB         &kp Q           &kp W         &kp E         &kp R     &kp T                                &kp Y      &kp U   &kp I      &kp O    &kp P             &kp BACKSLASH
&kp RCTRL       &kp A           &kp S         &kp D         &kp F     &kp G                                &kp H      &kp J   &kp K      &kp L    &kp SEMI          &kp SQT
&kp LEFT_SHIFT  &kp Z           &kp X         &kp C         &kp V     &kp B      &tog 8     &kp EQUAL      &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH          &kp MINUS
&kp GLOBE       &sk LEFT_SHIFT  &kp CAPSLOCK  &kp LEFT_WIN  &kp LALT  &kp SPACE  &kp ENTER  &kp BACKSPACE  &kp SPACE                              &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;
        };
    };
};
